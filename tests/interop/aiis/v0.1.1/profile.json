          "type": "enum",
          "values": [
            "READ_WRITE",
            "READ_ONLY",
            "UNAVAILABLE",
            "UNKNOWN"
          ]
        },
        "google_drive": {
          "type": "enum",
          "values": [
            "READ_WRITE",
            "READ_ONLY",
            "UNAVAILABLE",
            "UNKNOWN"
          ]
        },
        "user_attachment": {
          "type": "enum",
          "values": [
            "READ_WRITE",
            "READ_ONLY",
            "UNAVAILABLE",
            "UNKNOWN"
