      "values": [
        "VERIFIED",
        "UNVERIFIED",
        "STALE",
        "UNKNOWN"
      ],
      "required": true
    },
    {
      "id": "C1014",
      "name": "finding_code",
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "description": "Concrete machine-readable finding identifier. Preserve supplied validator/error identifiers exactly when authoritative for the case."
    },
    {
      "id": "C1020",
      "name": "proposed_change",
      "type": [
        "string",
        "null"
      ],
      "required": true
    },
    {
      "id": "C1021",
      "name": "validation_command",
      "type": [
        "string",
        "null"
      ],
      "required": true
    },
    {
      "id": "C1022",
      "name": "validation_result",
      "type": "enum",
      "values": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_RUN"
      ],
      "required": true
    },
    {
      "id": "C1030",
      "name": "review_decision",
      "type": "enum",
      "values": [
        "ACCEPT",
        "NO_CHANGE",
        "CHANGE_REQUIRED",
        "NEEDS_EVIDENCE"
