      "id": "C1000",
      "name": "repository",
      "type": "string",
      "required": true
    },
    {
      "id": "C1001",
      "name": "source_commit",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "required": true
    },
    {
      "id": "C1002",
      "name": "canonical_authority",
      "type": "string",
      "required": true
    },
    {
      "id": "C1003",
      "name": "target_path",
      "type": [
        "string",
        "null"
      ],
      "required": true
    },
    {
      "id": "C1010",
      "name": "finding_category",
      "type": "enum",
      "values": [
        "CANONICAL_AUTHORITY",
        "MIR_STRUCTURAL_ERROR",
        "VALIDATION_STATUS",
        "CHANGE_PROPOSAL",
        "SEMANTIC_EQUIVALENCE",
        "RESOURCE_CAPABILITY"
      ],
      "required": true
    },
    {
      "id": "C1011",
      "name": "severity",
      "type": "enum",
      "values": [
        "INFO",
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "required": true
    },
    {
      "id": "C1012",
      "name": "spec_violation",
